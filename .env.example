# Local development (bootRun / ng serve against Compose Postgres on host port 5437)
DATABASE_URL=jdbc:postgresql://localhost:5437/arbitrage
DATABASE_USERNAME=arbitrage
DATABASE_PASSWORD=arbitrage

# Host port for the Nginx frontend (Compose). Change if 8080 is already in use.
FRONTEND_PORT=8080

# Inside docker compose the backend service overrides JDBC to:
#   DATABASE_URL=jdbc:postgresql://postgres:5432/arbitrage
# Full stack: docker compose up --build  →  http://localhost:${FRONTEND_PORT}
